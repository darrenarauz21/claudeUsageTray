<Project Sdk="Microsoft.NET.Sdk">

  <!-- Uso de Claude para Linux y macOS (también corre en Windows, para probar). Comparte Core/ con la
       app de Windows (WinForms); solo la interfaz es propia. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UsoDeClaude</AssemblyName>
    <RootNamespace>ClaudeUsageTray</RootNamespace>
    <Version>2.1.0</Version>
    <AssemblyTitle>Uso de Claude</AssemblyTitle>
    <Product>Uso de Claude</Product>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- En Linux, .NET necesita ICU para las fechas en español y no todas las distribuciones la traen:
       la app lleva la suya. Windows y macOS ya la tienen. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

</Project>
